{
  "_comment": [
    "Group definitions for organize.py. Order matters: the first group whose",
    "`from` contains the icon's vendor prefix AND whose `match` list hits the",
    "remainder of the filename wins. A group with an empty `match` claims every",
    "icon carrying one of its `from` prefixes. Patterns are Python regexes,",
    "case-insensitive, tested with re.search against the filename WITHOUT the",
    "vendor prefix (so `other-user-admin.svg` is tested as `user-admin`).",
    "Icons matching nothing land in `fallback`."
  ],
  "fallback": "symbols",
  "groups": [
    {
      "slug": "products",
      "display": "F5 Products",
      "description": "F5 Product icons: BIG-IP, NGINX, Distributed Cloud and platform tooling",
      "from": ["__force_group_only__"],
      "match": [],
      "_note": "Filled by `organize.py --force-group products` from the F5 Product icons export (brand.f5.com/document/187). The unmatchable `from` keeps the prefix rules from ever claiming an icon for it."
    },
    {
      "slug": "ai",
      "display": "F5 AI",
      "description": "AI factories, gateways, guardrails, inference and model operations",
      "from": ["ai"],
      "match": []
    },
    {
      "slug": "security",
